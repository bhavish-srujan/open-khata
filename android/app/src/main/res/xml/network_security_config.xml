<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds must use HTTPS and reject cleartext outright — no domain
  exceptions here, not even for loopback/LAN addresses. Local development
  (emulator alias, LAN IPs, localhost) is handled entirely by the debug-only
  overlay at src/debug/res/xml/network_security_config.xml, which permits
  cleartext everywhere but only ships in debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
