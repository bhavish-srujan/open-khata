PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/khatabook

# JWT Secret for our own backend tokens
JWT_SECRET=your_jwt_secret_here

# TextBee SMS gateway (https://textbee.dev) — the ONLY OTP delivery provider,
# and also carries customer-facing messages (balance updates, reminders,
# welcome texts). Without both values set, sends are mocked: logged to the
# server console and reported as successful without a message ever going out.
# There is no WhatsApp or other fallback for OTP delivery.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional: request timeout to the gateway, in ms. Defaults to 5000.
SMS_GATEWAY_TIMEOUT_MS=

# Object storage for uploaded receipts. REQUIRED in production: container
# filesystems on Render and Fly are destroyed on every deploy, so a local disk
# would lose every receipt while the database row survives. Works with any
# S3-compatible provider (Cloudflare R2, AWS S3, MinIO).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for R2 and MinIO; omit for AWS S3.
S3_ENDPOINT=
S3_REGION=auto
# MinIO and some self-hosted gateways need path-style addressing.
S3_FORCE_PATH_STYLE=false
# Provider-specific: AES256 on AWS S3, leave blank for R2 (encrypted at rest
# already) and for MinIO without KMS.
S3_SERVER_SIDE_ENCRYPTION=

# Comma-separated browser origins allowed to call this API. Blank blocks all
# cross-origin browser access; the Android client is unaffected.
CORS_ORIGINS=

# Optional AI scanning configuration.
GEMINI_API_KEY=
# Ceiling for the Gemini generateContent call in ScanningService (image +
# extraction prompt), in ms. Defaults to 15000 if unset, which is too tight
# for a real photographed ledger image — a 57KB test image alone took ~5.9s
# against ~1.5s for a text-only call, and real camera photos run larger.
# 45000 is the production value; this is a client-side wait bound (via
# Promise.race), not a request cancellation — a slower response is simply
# never awaited past this point.
AI_TIMEOUT_MS=45000
# Scan Khata's Gemini model. Defaults to gemini-flash-lite-latest if unset —
# see scanning.service.ts's DEFAULT_MODEL. Two candidates were ruled out on
# testing against a real key: gemini-2.5-flash (404 "no longer available to
# new users" — Google gates the whole 2.5 generation behind an account
# creation-date cutoff) and gemini-3.5-flash (60% 503 "high demand" across 5
# real image requests). gemini-flash-lite-latest measured 5/5 success at
# ~2.8s average. It is an alias — it can silently move to a different
# underlying model — so if Scan Khata's error rate climbs, re-test a few
# real image requests against it before assuming the code regressed.
GEMINI_MODEL=gemini-flash-lite-latest

# Automated daily collection reminders (09:00, to every customer who owes money).
# Off unless set to exactly "true". There is no per-party throttle yet, so an
# enabled job texts the same customer every morning until their balance clears.
REMINDERS_ENABLED=false
# Smallest balance worth an SMS. Must be above 0; anything else falls back to 1.
REMINDER_MIN_BALANCE=1
